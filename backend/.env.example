# ==============================================================================
# QATRA ENVIRONMENT VARIABLES TEMPLATE
# Order aligns with the "From-Scratch Web Console Setup Guide"
# ==============================================================================

# ------------------------------------------------------------------------------
# PART 1: SUPABASE
# ------------------------------------------------------------------------------

# 1.3 Database Connection Strings
# Use the Transaction pooler (port 6543) for the actual running app's DATABASE_URL
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres

# Use Direct connection (port 5432) ONLY for running alembic migrations manually
DIRECT_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# 1.4 & 1.5 Storage Buckets & API Credentials (S3-Compatible API)
S3_ENDPOINT_URL=https://[project-ref].supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_supabase_s3_access_key
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
S3_REGION=us-east-1
S3_HOSPITAL_SLIPS_BUCKET=hospital-slips
S3_CNIC_DOCUMENTS_BUCKET=cnic-documents

# 1.5 Project URL & API Keys
SUPABASE_URL=https://[project-ref].supabase.co
# Backend needs the service_role key for elevated privileges. NEVER expose to client.
SUPABASE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# PART 2: FIREBASE
# ------------------------------------------------------------------------------

# 2.5 Admin SDK Service Account Key
# Paste the full JSON contents as a single-line string (or point to a secure file path).
# NEVER commit the actual JSON file.
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"..."}

# ------------------------------------------------------------------------------
# PART 3: APP SECURITY (EC2 Backend)
# ------------------------------------------------------------------------------

# 3.7 Deploy your backend
# Generate a fresh secure string using: openssl rand -hex 32
SECRET_KEY=your_secure_random_string_here

# ------------------------------------------------------------------------------
# ANDROID RELEASE SIGNING (For CI / Local Builds Only)
# ------------------------------------------------------------------------------
# KEYSTORE_PATH=PATH_TO_RELEASE_KEYSTORE
# STORE_PASSWORD=YOUR_STORE_PASSWORD_HERE
# KEY_PASSWORD=YOUR_KEY_PASSWORD_HERE
