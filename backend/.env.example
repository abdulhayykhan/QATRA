# App Security
SECRET_KEY=your_secure_random_string_here

# Database (Supabase)
# Use transaction pooler (port 6543) for app runtime
DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres
# Use direct connection (port 5432) for running alembic migrations
DIRECT_DATABASE_URL=postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres

# Supabase API (Storage S3-Compatible API)
S3_ENDPOINT_URL=https://your-project-ref.supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your_supabase_s3_access_key
S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
S3_REGION=us-east-1
S3_HOSPITAL_SLIPS_BUCKET=hospital-slips
S3_CNIC_DOCUMENTS_BUCKET=cnic-documents

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# Firebase Admin
FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}

# AWS (if applicable)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
