# Android build: Supabase project URL from Supabase Dashboard -> Project Settings -> API.
# Android reads this value from local.properties through app/build.gradle.kts, not from .env directly.
SUPABASE_URL=YOUR_SUPABASE_URL_HERE

# Android build: Supabase anon/public key from Supabase Dashboard -> Project Settings -> API.
# Android reads this value from local.properties through app/build.gradle.kts, not from .env directly.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# Android release signing: path to the release keystore on the build machine.
KEYSTORE_PATH=PATH_TO_RELEASE_KEYSTORE

# Android release signing: keystore password from the release keystore owner/CI secret store.
STORE_PASSWORD=YOUR_STORE_PASSWORD_HERE

# Android release signing: key password for the upload key in the release keystore.
KEY_PASSWORD=YOUR_KEY_PASSWORD_HERE

# Supabase Edge Function send-geo-alert: service-role key from Supabase Dashboard -> Project Settings -> API.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# Supabase Edge Function send-geo-alert: Firebase project ID from Firebase Console -> Project settings.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID_HERE

# Supabase Edge Function send-geo-alert: Firebase service-account client email from the downloaded service-account JSON.
FIREBASE_CLIENT_EMAIL=YOUR_FIREBASE_CLIENT_EMAIL_HERE

# Supabase Edge Function send-geo-alert: Firebase service-account private key from the downloaded service-account JSON.
# Preserve PEM content; escaped newlines are accepted by the function.
FIREBASE_PRIVATE_KEY=YOUR_FIREBASE_PRIVATE_KEY_HERE

# Supabase Edge Function webhook authentication: private value configured on the Supabase Database Webhook.
GEO_ALERT_WEBHOOK_SECRET=YOUR_GEO_ALERT_WEBHOOK_SECRET_HERE

# GEMINI_API_KEY is intentionally not listed: no repository code currently references it.
# It appears to be dead configuration and should be removed only after the team confirms it is no longer needed.